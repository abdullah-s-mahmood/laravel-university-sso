{
  "name": "university-sso/laravel-university-sso",
  "description": "Generic OIDC and broker context SDK for Laravel",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "illuminate/support": "^12.0 || ^13.0",
    "illuminate/http": "^12.0 || ^13.0",
    "illuminate/session": "^12.0 || ^13.0",
    "firebase/php-jwt": "^7.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0 || ^11.0",
    "phpunit/phpunit": "^11.5 || ^12.0",
    "laravel/pint": "^1.0",
    "phpstan/phpstan": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "UniversitySso\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "UniversitySso\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "UniversitySso\\SsoServiceProvider"
      ],
      "aliases": {
        "UniversitySso": "UniversitySso\\Facades\\Sso"
      }
    }
  },
  "scripts": {
    "test": "phpunit",
    "style": "pint --test",
    "analyse": "phpstan analyse --memory-limit=512M",
    "check": [
      "@test",
      "@style",
      "@analyse"
    ]
  }
}