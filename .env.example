# Consumer-owned settings. Generate APP_KEY with php artisan key:generate.
SSO_ISSUER=https://id.example.invalid
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=https://app.example.invalid/sso/callback
SSO_BROKER_URL=https://broker.example.invalid
SSO_POST_LOGOUT_REDIRECT_URI=https://app.example.invalid/
# Configure scopes/refresh in config/university-sso.php; no provider-specific scope is assumed.
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Omit SESSION_DOMAIN for a host-only cookie; give each consumer its own cookie name.
SESSION_COOKIE=consumer_session

# Opt in only with rotating provider refresh tokens and shared atomic cache.
SSO_REFRESH_ENABLED=false
